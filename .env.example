# RHoSAM HCM - Environment Variables
# Copy this file to .env and fill in the values

# ===========================
# REQUIRED - Database
# ===========================
DATABASE_URL=postgresql://postgres:password@host:5432/dbname

# ===========================
# REQUIRED - Authentication
# ===========================
SESSION_HOURS=24
ADMIN_EMAIL=admin@rhosamhr.com
ADMIN_PASSWORD=YourSecurePassword123

# ===========================
# REQUIRED - App Config
# ===========================
NODE_ENV=production
PUBLIC_BASE_URL=https://rhosamhr.com

# ===========================
# OPTIONAL - Email (Resend)
# ===========================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=RHoSAM HCM <noreply@rhosamhr.com>

# ===========================
# OPTIONAL - Cron Security
# ===========================
# Generate a random string for cron job authentication
CRON_SECRET=your-random-cron-secret-here

# ===========================
# OPTIONAL - Google Sheets Import
# ===========================
# Paste the entire JSON content of your service account key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ===========================
# OPTIONAL - SSL
# ===========================
# Set to "false" to disable SSL for local development
DATABASE_SSL=true
